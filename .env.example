# Copy this file to .env and fill in values for local development.
# CRA only exposes vars prefixed with REACT_APP_ to the browser bundle.
# Restart `npm start` after changing values.
#
# WARNING: any REACT_APP_* value is compiled into the public JS bundle. If you
# ever build/deploy this app, values below become visible to anyone via
# browser devtools/network tab. Use a backend proxy (REACT_APP_ANALYZE_URL)
# for anything beyond local testing.
#
# NOTE: the OpenAI API key is no longer configured here. Enter it via the
# in-app Settings (gear icon in the sidebar) — it's stored only in that
# browser's localStorage, never in this file or the build bundle.
# See src/lib/settingsStore.js and src/lib/analyzer.js.

# Base URL of your own document-analysis backend. When set, this takes
# priority over the in-app OpenAI key. When unset, the app falls back to the
# localStorage-held OpenAI key, then to a built-in mock analyzer.
REACT_APP_ANALYZE_URL=https://your-api.example.com/analyze

# Optional bearer token sent to REACT_APP_ANALYZE_URL (only for dev/non-sensitive tokens).
REACT_APP_ANALYZE_API_KEY=
